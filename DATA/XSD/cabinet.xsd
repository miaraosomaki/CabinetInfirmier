<?xml version="1.0" encoding="UTF-8" ?>
<schema xmlns="http://www.w3.org/2001/XMLSchema"
        xmlns:cb="https://www.univ-grenoble-alpes.fr/l3miage/medical"    
        targetNamespace ="https://www.univ-grenoble-alpes.fr/l3miage/medical"
        elementFormDefault="qualified"
>
    
    <element name="cabinet" type="cb:Cabinet"/>
    
    <!--Cabinet-->
    <complexType name="Cabinet">
        <sequence>
            <element name="nomC" type="string"/>
            <element name="adresseC" type="cb:Adresse"/>
            <element name="infirmiers" type="cb:Infirmiers"/>
            <element name="patients" type="cb:Patients"/>
        </sequence>
    </complexType>
    
    <!--Type Adresse-->
    <complexType name="Adresse">
        <sequence>
            <element name="etage" type="cb:EntiersPositifs" minOccurs="0" />
            <element name="numero" type="cb:EntiersPositifs"  minOccurs="0"/>
            <element name="rue" type="string"/>
            <element name="codePostal" type="cb:CodePostal"/>
            <element name="ville" type="cb:Nom"/>
        </sequence>
    </complexType>
    
    <!--Type EntiersPositifs-->
    <simpleType name="EntiersPositifs">
        <restriction base="int">
            <minInclusive value="0"/>
        </restriction>
    </simpleType>

    <!--Type CodePostal-->
    <simpleType name="CodePostal">
        <restriction base="int">
            <pattern value="[0-9]{5}"/>
        </restriction>
    </simpleType>

    <!--Type pour les noms propres-->
    <simpleType name="Nom">
        <restriction base="string">
            <pattern value="[A-Z][A-Za-z éèêëàâîïôöùûüç]+"/>
        </restriction>
    </simpleType>

    <!--Type pour Infirmiers en général-->
    <complexType name="Infirmiers">
        <sequence>
            <element name="infirmier" type="cb:Infirmier" minOccurs="1" maxOccurs="unbounded"/>
        </sequence>
    </complexType>
    
    <!--Type pour un Infirmier-->
    <complexType name="Infirmier">
        <sequence>
            <element name="nomI" type="cb:Nom"/>
            <element name="prenomI" type="cb:Nom"/>
            <element name="photo" type="cb:Photo"/>
        </sequence>
        <attribute name="idI" type="cb:Identifiant" use="required"/>
    </complexType>

    <!--Type pour les identifiants-->
    <simpleType name="Identifiant">
        <restriction base="int">
            <pattern value="[0-9]{3}"/>
        </restriction>
    </simpleType>

    <!--Type pour les photo-->
    <simpleType name="Photo">
        <restriction base="string">
            <pattern value=".*\.(jpg|png)"/>
        </restriction>
    </simpleType>

    <!--Type pour les Patients-->
    <complexType name="Patients">
        <sequence>
            <element name="patient" type="cb:Patient" minOccurs="1" maxOccurs="unbounded"/>
        </sequence>
    </complexType>

    <complexType name="Patient">
        <sequence>
            <element name="nomP" type="cb:Nom"/>
            <element name="prenomP" type="cb:Nom"/>
            <element name="sexe" type="cb:Sexe"/>
            <element name="naissance" type="date"/>
            <element name="adresseP" type="cb:Adresse"/>
            <element name="numeroP" type="cb:NumeroSecurite"/>
            <element name="visite" type="cb:Visite" minOccurs="0" maxOccurs="unbounded"/>
        </sequence>
    </complexType>
    
    <!--Type pour les sexes-->
    <simpleType name="Sexe">
        <restriction base="string">
            <enumeration value="F"/>
            <enumeration value="M"/>
            <enumeration value="Autre"/>
        </restriction>
    </simpleType>

    <!--Type pour les numeros de secu-->
    <!--
        STRUCTURE DU NUMÉRO DE SÉCURITÉ SOCIALE (NIR) - RÈGLE GÉNÉRALE :
        Composé de 15 chiffres : [13 chiffres d'identification] + [2 chiffres de clé de contrôle]
    
        1. Les 13 premiers chiffres :
           - 1er chiffre   : Sexe (1 = Homme, 2 = Femme)
           - Chiffres 2-3  : Deux derniers chiffres de l'année de naissance (ex. 82 pour 1982)
           - Chiffres 4-5  : Mois de naissance (01 à 12)
           - Chiffres 6-7  : Département de naissance (01 à 95, 2A/2B pour la Corse, 99 pour l'étranger)
           - Chiffres 8-10 : Code commune Insee de naissance (3 chiffres)
           - Chiffres 11-13: Numéro d'ordre de l'acte de naissance dans le mois et la commune (3 chiffres)
    
        2. Calcul de la clé de contrôle (2 chiffres) :
           - Algorithme officiel : complément à 97 du reste de la division euclidienne
           - Formule : Clé = 97 - (NIR_13_chiffres modulo 97)
           * Note : si le résultat est inférieur à 10, on ajoute un 0 devant (ex. 05).
           * Si le reste vaut 0, la clé vaut 97.
    -->
    <simpleType name="NumeroSecurite">
        <restriction base="string">
            <pattern value="[12][0-9]{2}(0[1-9]|1[0-2])[0-9]{2}[0-9]{3}[0-9]{3}[0-9]{2}"/>
        </restriction>
    </simpleType>
    
    <!--Type pour les visites-->
    <complexType name="Visite">
        <sequence>
            <element name="acte" type="cb:Acte" minOccurs="1" maxOccurs="unbounded"/>
        </sequence>
        <attribute name="date" type="date" use="required"/>
        <attribute name="intervenant" type="cb:Identifiant" />
    </complexType>
    
    <!--Type pour actes-->
    <complexType name="Acte">
        <attribute name="idA" type="cb:Identifiant" use="required"/>
        <attribute name="type" type="cb:TypeActe" use="required"/>
        <attribute name="cle" type="cb:CleActe" use="required"/>
        <attribute name="coef" type="float" use="required"/>
    </complexType>
    
    <!---->
    <simpleType name="TypeActe">
        <restriction base="string">
            <enumeration value="pi"/><!---->
            <enumeration value="pc"/><!---->
            <enumeration value="pl"/><!---->
            <enumeration value="sd"/><!---->
        </restriction>
    </simpleType>

    <!---->
    <simpleType name="CleActe">
        <restriction base="string">
            <enumeration value="AMI"/><!---->
            <enumeration value="AIS"/><!---->
            <enumeration value="DI"/><!---->
        </restriction>
    </simpleType>
    <!---->
    <!---->
    <!---->
    <!---->
    <!---->
</schema>