@startuml

package XMLSchema {
  class string
  class int
  class date
}

package medical {

  class "<<racine>>\ncabinet" as RacineCabinet
  RacineCabinet --> Cabinet

  class Cabinet {
    -nom : string
  }

  class Adresse {
    -numero : string
    -rue : string
    -codePostal : string
    -ville : string
  }

  class Infirmier {
    -id : string
    -nom : string
    -prenom : string
    -photo : string
  }

  class Patient {
    -nom : string
    -prenom : string
    -naissance : date
  }

  class AdressePatient {
    -etage : int
    -numero : string
    -rue : string
    -codePostal : string
    -ville : string
  }

  class Visite {
    -date : date
    -intervenant : string
  }

  class Acte {
    -id : string
  }

  enum Sexe {
    M = M
    F = F
  }

  class NumeroSS <<pattern>> {
    \d{13}\s\d{2}
  }

  Cabinet "1" *-- "1" Adresse
  Cabinet "1" o-- "1..*" Infirmier : infirmiers
  Cabinet "1" o-- "0..*" Patient : patients

  Patient "1" *-- "1" AdressePatient
  Patient "1" o-- "0..*" Visite : visites
  Patient "1" *-- "1" Sexe : sexe
  Patient "1" *-- "1" NumeroSS : numero

  Visite "1" o-- "1..*" Acte : actes
}

@enduml